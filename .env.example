#######################################
# Telegram Bot
#######################################

# Telegram Bot Token
TG_BOT_TOKEN=
# 你的 chat_id（私聊一般是正数，群组通常是负数）
TG_CHAT_ID=


#######################################
# Telegram Topics（message_thread_id）
# 按最大周期路由
#######################################

TG_TOPIC_US=
TG_TOPIC_DAY=
TG_TOPIC_4H=
TG_TOPIC_1H=
TG_TOPIC_15MIN=
TG_TOPIC_SUMMARY=

#######################################
# Dashboard 归档（resonance_dashboard，跨服务器 HTTPS）
#######################################
# resonance_dashboard 公网地址 + /signals 路径
DASHBOARD_PUSH_URL=
# 双方约定的共享密钥（X-Resonance-Token）
DASHBOARD_PUSH_TOKEN=

#######################################
# 老五 bot 监听器（laowu-listener）
#######################################
# 重点关注话题（老五信号推送到这里）
TG_TOPIC_FOCUS=
# Telegram 用户 API（my.telegram.org 获取）
TG_API_ID=
TG_API_HASH=
# 老五 bot 的 user_id；留空则进入探测模式，只打印发送者 ID
LAOWU_BOT_ID=

#######################################
# Claude API
#######################################
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024